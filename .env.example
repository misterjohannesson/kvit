# Copy to .env for local runs (npm run dev / npm start / npm run seed).
# Docker Compose also reads .env from this directory for ${APP_PASSWORD}.
# Variables set in the shell always win over this file.

# The single shared login password (required).
APP_PASSWORD=skift-mig

# Where the SQLite database and all PDFs/receipts live. Docker uses /data.
DATA_DIR=./data

# Optional: port and bind address for `npm start` (adapter-node).
# PORT=3000
# HOST=127.0.0.1

# Optional: request body limit; uploads are refused above 20 MB regardless.
# BODY_SIZE_LIMIT=25M
