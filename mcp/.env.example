# Copy to mcp/.env for local runs (npm run mcp / npm run mcp:http from the repo root, or npm start in mcp/).
# Variables set in the shell always win over this file. The file is git-ignored.
#
# If FAKTURA_API_TOKEN is not set here, the app's own .env in the repo root is consulted for API_TOKEN (and PORT),
# so one token can live in one place when you run both from the repo.

# Where the app runs.
FAKTURA_URL=http://127.0.0.1:3000

# Must equal the app's API_TOKEN (at least 16 characters).
# FAKTURA_API_TOKEN=et-langt-tilfaeldigt-token

# Streamable HTTP transport only (npm run mcp:http).
# MCP_HOST=127.0.0.1
# MCP_PORT=3333
# MCP_ALLOWED_HOSTS=100.64.0.12:3333
