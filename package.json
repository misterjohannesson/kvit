    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "pdf-lib": "^1.17.1",
    "playwright": "1.63.0",
    "svelte": "^5.57.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "adm-zip": "^0.6.0",
    "drizzle-kit": "^0.31.10",
    "pdf-parse": "^2.4.5",
    "svelte-check": "^4.7.6",
